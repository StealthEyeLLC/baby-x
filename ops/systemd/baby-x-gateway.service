[Unit]
Description=Baby-X unprivileged private gateway
After=network.target baby-x.socket
Requires=baby-x.socket
[Service]
Type=simple
User=fix-mcp
Group=horsey
ExecStart=/opt/node-v24.18.0-linux-x64/bin/node /opt/baby-x/current/gateway/main.js
Environment=NODE_ENV=production
EnvironmentFile=-/etc/baby-x/gateway-environment
EnvironmentFile=-/etc/baby-x/gateway-key-environment
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/baby-x-gateway
RestrictSUIDSGID=yes
LockPersonality=yes
[Install]
WantedBy=multi-user.target
