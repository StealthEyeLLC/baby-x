[Unit]
Description=Baby-X private owner control socket
Before=baby-x.service

[Socket]
ListenStream=/run/horsey/baby-x.sock
SocketUser=root
SocketGroup=horsey
SocketMode=0660
DirectoryMode=0750
FileDescriptorName=baby-x
Accept=no
RemoveOnStop=yes
Service=baby-x.service
Backlog=128

[Install]
WantedBy=sockets.target
